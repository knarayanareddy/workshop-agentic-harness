# Build output
.gradle/
.kotlin/
build/
node_modules/
dist/

# IDE and OS files
.idea/
*.iml
.DS_Store
Thumbs.db

# The agent's sandbox: only the README and the OpenRA toolbox are committed
workspace/*
!workspace/README.md
!workspace/docker/

# Standalone harness packages (docker build --output . .)
agentic-harness/

# Session reports written by /report
reports/

# Local secrets
.env

# The 48 reference solutions, placed into their exercise packages by
# prototype/scripts/place-solutions.mjs for a compile check (CI + `npm run solutions:verify`).
# They are copies of prototype/data/solutions/ and must never be committed: attendees write these.
extensions/kotlin/src/**/exercise/*.kt
extensions/java/src/**/exercise/*.java
extensions/typescript/src/**/exercise/*.ts

# Downloaded source archives (the delivered zip is a snapshot, not source)
google_drive/
