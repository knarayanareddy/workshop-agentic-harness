{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Only the ECMAScript library: no DOM, no Node. setTimeout, fetch and fs do not exist in the
    // embedded runtime, so they should not type-check either.
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@harness/api": ["../../harness-api/typescript/harness.ts"]
    }
  },
  "include": ["src", "../../harness-api/typescript"]
}
