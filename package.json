{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "vite-node prototype/scripts/verify.tsx",
    "regress": "vite-node prototype/scripts/regress.ts",
    "smoke": "vite-node prototype/scripts/dom-smoke.tsx",
    "gen-docs": "vite-node prototype/scripts/gen-docs.ts",
    "extract": "node prototype/scripts/extract.mjs",
    "solutions:install": "node prototype/scripts/place-solutions.mjs install .",
    "solutions:verify": "node prototype/scripts/place-solutions.mjs verify .",
    "solutions:clean": "node prototype/scripts/place-solutions.mjs clean ."
  },
  "dependencies": {
    "@harness/api": "file:prototype/contract/v1",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "2.3.0"
  }
}
